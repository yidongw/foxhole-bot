# Robinhood Chain RPC (Alchemy free tier recommended)
# Paste a fresh Alchemy key on BOTH lines below and restart the monitor —
# HTTP for reads (auto-falls back to the public RPC when the key 429s/caps out,
# so a spent quota degrades gracefully instead of blinding the engine),
# WSS for sub-second smart-money push (watcher falls back to poll mode on error).
ROBINHOOD_RPC=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
ROBINHOOD_WSS=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Discord alerts
DISCORD_WEBHOOK_URL=

# Monitor poll interval (ms, default 300000 = 5 min)
POLL_INTERVAL_MS=300000

# Launch alerts from the factory watcher: digest (default) | each | off
LAUNCH_ALERT_MODE=digest

# Chains to monitor (comma-separated): robinhood,solana,bsc,base,ethereum
CHAINS=robinhood
# Chains allowed to open trades (paper or live). Default robinhood only.
TRADE_CHAINS=robinhood
# Open-position price/exit check interval (ms, default 15000)
POSITION_TICK_MS=15000

# BlockBeats（区块律动）news watcher: 1=on (default), 0=off
BLOCKBEATS_NEWS=1
# 新闻雷达频道 webhook（建议频道名 #news-radar / 新闻雷达）。
# 备考/留痕/被判定否决的新闻都发这里；不配则不上 Discord（收件箱/thread 投递不受影响）
#DISCORD_NEWS_WEBHOOK_URL=
# News poll interval (ms, default 180000 = 3 min)
NEWS_POLL_MS=180000
# Official BlockBeats API key (free tier: apply at theblockbeats.info/apiDoc).
# Until set, the watcher scrapes the public newsflash pages instead.
#BLOCKBEATS_API_KEY=
# 6551 / OpenNews（@cryptoxiao，opennews-mcp）AI 打分新闻+推特信号源。
# 免票即可跑 `npm run opennews`（分类热点 + 推特情绪 --twitter）；
# 配 token 后解锁全量搜索 `npm run opennews -- --signal=long|--coin=BTC`。
# 免费申请：https://6551.io/mcp
#OPENNEWS_TOKEN=
#OPENNEWS_API_BASE=https://ai.6551.io
# 6551 watcher（monitor 内）：有 OPENNEWS_TOKEN 时自动开，把高分方向性信号
# (long/short, score≥OPENNEWS_MIN_SCORE) 推到 #news-radar。OPENNEWS_WATCH=0 强制关。
# Free 版配额小，轮询默认 10min。
#OPENNEWS_WATCH=1
#OPENNEWS_POLL_MS=600000
#OPENNEWS_MIN_SCORE=80
# Claude model that judges wake-worthy news (needs ANTHROPIC_API_KEY)
#NEWS_ANALYST_MODEL=claude-opus-5

# Per-chain RPC overrides (defaults: public endpoints)
#BSC_RPC=
#BASE_RPC=
#ETH_RPC=
#SOLANA_RPC=

# Solana pump.fun launch watcher (active when CHAINS includes "solana").
# Fresh mints ≥ this market cap enter probation; once DexScreener indexes them
# on Solana with liquidity ≥ threshold they graduate to analyzed/graded alerts.
#PUMP_MIN_DISCOVERY_MCAP=12000
#PUMP_MIN_LIQUIDITY_USD=15000
#PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# Pre-graduation entry: on-curve probation tokens with ≥ this 24h volume get an
# on-chain curve read + analysis so `curve_near_grad_strong` (the SOL trade-grade
# entry trigger) can fire before graduation. Bounded to N candidates per tick.
#PUMP_NEAR_GRAD_MIN_VOLUME_USD=20000
#PUMP_NEAR_GRAD_MAX_CANDIDATES=6
# Jupiter (SOL) execution: reject swaps whose quoted price impact exceeds this
# fraction (thin pool guard). Decimals are resolved from the mint automatically.
#JUPITER_MAX_PRICE_IMPACT_PCT=0.15
# Priority fee so swaps land under congestion: dynamic estimate at this level
# (medium|high|veryHigh), capped by max lamports (1_000_000 = 0.001 SOL).
#JUPITER_PRIORITY_LEVEL=high
#JUPITER_PRIORITY_FEE_MAX_LAMPORTS=1000000

# BSC four.meme pre-graduation entry (active when CHAINS includes "bsc"): on-curve
# probation tokens with ≥ this 24h volume get an on-chain curve read + analysis so
# `curve_near_grad_strong` (a BSC trade-grade entry trigger) can fire before
# graduation. Bounded to N candidates per tick. Mirrors the pump.fun near-grad path.
#FOURMEME_NEAR_GRAD_MIN_VOLUME_USD=20000
#FOURMEME_NEAR_GRAD_MAX_CANDIDATES=6

# Per-chain live-trading keys (throwaway wallets only; paper mode needs none)
#BSC_PRIVATE_KEY=
#BASE_PRIVATE_KEY=
#SOLANA_PRIVATE_KEY=

# GoPlus pre-entry safety gate (default on; 0 to disable)
TRADE_SAFETY_GATE=1
# EVM round-trip honeypot gate: before a live v2 buy, simulate selling the
# tokens back (storage-override, 0 funds) and abort if the token can't be sold.
# Default on; 0 to disable. Skips silently for non-standard token storage.
#TRADE_SELL_PREFLIGHT=1

# Interactive Discord control bot (/positions /sell /sellall /pause /resume /status).
# Create a bot at https://discord.com/developers, invite with applications.commands.
# DISCORD_GUILD_ID makes commands register instantly (global takes ~1h).
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=

# Daily self-review loop (runs automatically every 24h inside the monitor):
# grades alerts vs 24h price action, scans for missed 暴涨 tokens, and
# auto-tunes signal thresholds via data/signal-overrides.json (bounded,
# backtest-gated). Manual run: npm run review
# Auto-commit+push adopted overrides to git (default off):
AUTO_TUNE_PUSH=0
# Dedicated Discord channels (channel → 整合 → Webhook → 复制URL);
# each falls back to DISCORD_WEBHOOK_URL when unset. Live assignment:
#   #trade-signal → DISCORD_WEBHOOK_URL — every message = a trade trigger:
#                   strong level + pre-pump entry trigger + safety gate pass.
#                   Momentum/spike "already pumped" strongs, watch/alert
#                   levels, and launch digests do NOT go here — they stay in
#                   alerts.json/dashboard (or DISCORD_FEED_WEBHOOK_URL below)
#DISCORD_FEED_WEBHOOK_URL=   # optional verbose feed channel (digests, low-grade signals)
#
# Per-chain channels: append _<CHAIN> to any webhook var; falls back to the
# global var when unset. Chains: ROBINHOOD SOLANA BSC BASE ETHEREUM. e.g.:
#DISCORD_SIGNAL_WEBHOOK_URL_SOLANA=   # #trade-signal-sol
#DISCORD_TRADE_WEBHOOK_URL_SOLANA=    # #trade-log-sol
#DISCORD_FILTER_WEBHOOK_URL_SOLANA=   # #filter-log-sol
# (DISCORD_SIGNAL_WEBHOOK_URL is the new global name; legacy
#  DISCORD_WEBHOOK_URL still works as the signal fallback)
#   #filter-log   → DISCORD_FILTER_WEBHOOK_URL + DISCORD_REVIEW_WEBHOOK_URL
#                   (daily mover judgments + confirmation checklist)
#   #trade-log    → DISCORD_TRADE_WEBHOOK_URL (entries/exits/vetoes + P&L)
#DISCORD_REVIEW_WEBHOOK_URL=
#DISCORD_FILTER_WEBHOOK_URL=
#DISCORD_TRADE_WEBHOOK_URL=
# The daily mover candidates PAUSE for human confirmation:
#   /review-confirm [exclude:1,3]   (Discord control bot)
#   npm run review:confirm [-- --exclude=1,3]
# Excluded tokens go to data/review-denylist.json permanently.
# LLM narrative in the daily report uses ANTHROPIC_API_KEY if present
#REVIEW_ANALYST_MODEL=claude-opus-5

# --- Smart-money tracking (multi-chain) ---
# Watches a curated wallet list (data/smart-money.json — manage via
#   npm run smartmoney add <address> <label> [--chain <chain>]).
#   npm run smartmoney find <chain> <token,token2> [--add-top N]  ← winner-finder
# RB chain: on-chain BUY detection (Transfer×Swap correlation, sub-second on wss).
# bsc/sol/base/eth: GMGN portfolio-activity polling (needs gmgn-cli + GMGN key).
# Single buy → alert filter → Discord; ≥CONVICTION_N distinct wallets/WINDOW_MIN
# AND buy ≥ AI_MIN_USD → AI-trigger filter → AI inbox wake + signal pipeline.
SMART_MONEY=1
# RB on-chain poll cadence when no wss endpoint is set (ms). ~3s latency.
#SMART_MONEY_TICK_MS=3000
# SUB-SECOND RB alerts: a WebSocket RPC endpoint (eth_subscribe). Auto-derived
# is not done for you — set it (Alchemy RB wss works; public RPC may not).
#ROBINHOOD_WSS=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
#SMART_MONEY_FLUSH_MS=800
# GMGN activity poll cadence for non-RB chains (ms) + per-call spacing.
#SMART_MONEY_POLL_MS=15000
#SMART_MONEY_GMGN_DELAY_MS=1200
# Alert filter: ignore buys below this USD. 0 = alert all.
#SMART_MONEY_MIN_USD=0
# Silence a wallet re-buying the SAME token within N min (anti-spam). RB
# defaults to 30 (a HOOD accumulator was flooding the channel); 0 = off.
#SMART_MONEY_ALERT_COOLDOWN_MIN=0
# AI-trigger filter: N distinct wallets / WINDOW_MIN minutes, and each buy must
# be ≥ AI_MIN_USD, to escalate into the AI analysis + signal pipeline.
#SMART_MONEY_CONVICTION_N=2
#SMART_MONEY_WINDOW_MIN=60
#SMART_MONEY_AI_MIN_USD=0
# AI-trigger anti-chase (skip waking AI on thin/already-pumped tokens; 0=off):
#SMART_MONEY_AI_MIN_LIQ_USD=20000
#SMART_MONEY_AI_MAX_PUMP_1H=100
#SMART_MONEY_AI_MAX_PUMP_24H=300
# Dedicated channel; falls back to the signal webhook when unset.
#DISCORD_SMARTMONEY_WEBHOOK_URL=
# Optional GMGN failover providers for the winner-finder (dormant until keyed):
#NANSEN_API_KEY=
#BIRDEYE_API_KEY=
# Cielo: SUB-SECOND per-wallet push for bsc/sol/base/eth (dormant until keyed).
# When set, Cielo takes over those chains and the GMGN poller skips them; RB
# stays on its own wss watcher. Verify Cielo's WS credit metering before relying.
#CIELO_API_KEY=
#CIELO_CHAINS=bsc,sol,solana,base,eth,ethereum
# AI analysis step (Claude) — needed for the AI-trigger to actually reason:
#ANTHROPIC_API_KEY=

# --- Trading (phase 2) ---
# off (default) | paper (simulated fills) | live (real swaps — DANGER)
TRADE_MODE=off
# Wallet key for LIVE mode only. Never commit. Use a dedicated hot wallet
# funded with only what you can lose.
#TRADER_PRIVATE_KEY=
TRADE_USD_PER_TRADE=50
# <=0 关闭 24h 资金占用上限(默认关;买入节奏由 AI 判断,现金兜底)
TRADE_MAX_DAILY_USD=0
# <=0 = 不限持仓数(默认不限;风险由 24h 资金占用上限兜底)
TRADE_MAX_OPEN_POSITIONS=0
TRADE_MIN_LIQUIDITY_USD=50000
TRADE_SLIPPAGE_BPS=100
TRADE_TRAIL_STOP_PCT=0.25
# Trail stop arms only once high-water >= entry * this (below it, only the hard stop guards)
TRADE_TRAIL_ARM_MULT=1.5
TRADE_HARD_STOP_PCT=0.35
TRADE_MAX_HOLD_HOURS=96
#TRADE_ENTRY_TRIGGERS=lock_strong,lock_rising_strong,boner_composite
#TRADE_DENYLIST=

# Optional LLM exit advisor (early exits only; never overrides stops).
# Requires ANTHROPIC_API_KEY. One call per open position per hour.
TRADE_LLM_ADVISOR=0
#ANTHROPIC_API_KEY=
#TRADE_ADVISOR_MODEL=claude-opus-5

# --- Hyperliquid 永续 (新闻驱动做多/做空;独立于上面的现货 TRADE_*) ---
# off (default) | paper (用 mid 价模拟) | live (真金签名下单 — 危险)
HL_MODE=off
# testnet 默认开:真金前先在测试网跑通开/平仓全链路
HL_TESTNET=1
# HIP-3 builder 永续 dex 名(美股/商品走 trade.xyz 之类);空=核心永续
#HL_DEX=
# 每笔名义敞口 (USD)。保证金 = 名义 / 杠杆
# <=0 不限单笔名义(默认;仓位大小由 AI 判断)
HL_USD_PER_TRADE=0
HL_DEFAULT_LEVERAGE=3
HL_MAX_LEVERAGE=5
# 保证金模式:isolated(做空/新标的推荐,亏损隔离) | cross
HL_MARGIN_MODE=isolated
# <=0 = 不限永续持仓数(默认不限;风险由 24h 名义敞口上限兜底)
HL_MAX_OPEN_PERPS=0
# 24h 名义敞口累计上限 (USD);<=0 关闭
# <=0 关闭 24h 名义敞口上限(默认关)
HL_MAX_DAILY_NOTIONAL_USD=0
# 硬止损:标的逆向变动超过该比例(注意 × 杠杆才是保证金亏损比例)
HL_HARD_STOP_PCT=0.15
# 移动止损:从有利极值回撤该比例
HL_TRAIL_STOP_PCT=0.1
# 止盈阶梯 "有利pct:平仓比例,…"(如 +10% 平 50%,+25% 再平 25%)
HL_TAKE_PROFITS=10:0.5,25:0.25
HL_MAX_HOLD_HOURS=72
# 模拟市价的最大滑点(HL 无原生市价单,用激进 IOC 限价)
HL_SLIPPAGE_BPS=50
HL_PAPER_START_USD=1000
# --- live 才需要(先装可选依赖:npm i @nktkas/hyperliquid@latest)---
# agent wallet 私钥(app.hyperliquid.xyz/API 生成并授权;无提现权,专供 bot)
#HL_AGENT_KEY=
# 主账户地址(agent 代签时用于查询/归属)
#HL_ACCOUNT_ADDRESS=

# --- OI 异动扫描器 (币安公开数据 → 妖币启动信号 → 永续做多;默认关) ---
# 1=开启 monitor 内的 OI 扫描循环(命中投递 AI 收件箱,由 decider 决策)
OI_SCAN=0
# 扫描间隔 (ms, 默认 180000 = 3 分钟)
OI_SCAN_MS=180000
# 四条件阈值(对齐 NewsLiquid 模板,可调):
OI_MIN_VALUE_USD=3000000      # OI 名义值下限
OI_MIN_RISE_PCT=3             # OI 涨幅下限 %
OI_LOOKBACK_BARS=1            # OI 涨幅回看根数(period 为单位)
OI_MIN_TOPTRADER_LONG=0.55    # 大户多头持仓占比下限 (0..1;主力方向/占比代理)
OI_MIN_PRICE_CHG_PCT=0        # 窗口价格顺方向幅度下限 %(默认不许逆向)
OI_MIN_QUOTE_VOL_24H=20000000 # 24h 成交额下限(剔除死盘)
OI_CANDIDATE_COUNT=25         # 每轮候选数(按 |24h涨跌| 取头部,控速)
OI_PERIOD=5m                  # OI 时序 period
# V2 主力盈利率(NewsLiquid 第3/4条的公开代理:OI加权反推主力成本 vs 现价):
OI_COST_WINDOW_BARS=12        # 反推主力成本的回看根数(12×5m=1h)
OI_MIN_WHALE_PROFIT_PCT=0     # 主力盈利率下限 %(0=只要在赚;调高更严)
# V2 软增强(阈值给到"要求档"才作硬门,否则仅展示计分):
OI_MAX_FUNDING_ABS=0.02       # 资金费率绝对值上限(拥挤/成本过滤;0=不过滤)
OI_MIN_DIVERGENCE=0           # 聪明钱vs散户背离下限(大户−散户,0..1;0=不要求)
OI_MIN_TAKER_DIR=0.5          # taker 顺方向主动量占比下限(0.5=不要求)
OI_ENABLE_SHORT=0             # 1=开启做空镜像(主力偏空+价跌+空头盈利)

# ── OKX DEX 聚合器路由(可选,RB 链多池聚合路由 + 原生限价单基建)──────────
# live 下单路由:
#   hoodchain(默认,直连 RB Uniswap v3,只认 v3 池)
#   okx       (只走 OKX 聚合器,含 v4;OKX 挂了不回退)
#   okx_hood  (OKX 主 + hoodchain 兜底:OKX 广播前失败才回退,不会重复下单)
TRADE_ROUTER=hoodchain
# OKX Web3 开发者后台申请(https://web3.okx.com → 开发者/API):四项缺一不可
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
