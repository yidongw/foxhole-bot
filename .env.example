# Robinhood Chain RPC (Alchemy free tier recommended)
ROBINHOOD_RPC=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Discord alerts
DISCORD_WEBHOOK_URL=

# Monitor poll interval (ms, default 300000 = 5 min)
POLL_INTERVAL_MS=300000

# Launch alerts from the factory watcher: digest (default) | each | off
LAUNCH_ALERT_MODE=digest

# Chains to monitor (comma-separated): robinhood,solana,bsc,base,ethereum
CHAINS=robinhood
# Chains allowed to open trades (paper or live). Default robinhood only.
TRADE_CHAINS=robinhood
# Open-position price/exit check interval (ms, default 15000)
POSITION_TICK_MS=15000

# Per-chain RPC overrides (defaults: public endpoints)
#BSC_RPC=
#BASE_RPC=
#ETH_RPC=
#SOLANA_RPC=

# Per-chain live-trading keys (throwaway wallets only; paper mode needs none)
#BSC_PRIVATE_KEY=
#BASE_PRIVATE_KEY=
#SOLANA_PRIVATE_KEY=

# GoPlus pre-entry safety gate (default on; 0 to disable)
TRADE_SAFETY_GATE=1

# Interactive Discord control bot (/positions /sell /sellall /pause /resume /status).
# Create a bot at https://discord.com/developers, invite with applications.commands.
# DISCORD_GUILD_ID makes commands register instantly (global takes ~1h).
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=

# Daily self-review loop (runs automatically every 24h inside the monitor):
# grades alerts vs 24h price action, scans for missed 暴涨 tokens, and
# auto-tunes signal thresholds via data/signal-overrides.json (bounded,
# backtest-gated). Manual run: npm run review
# Auto-commit+push adopted overrides to git (default off):
AUTO_TUNE_PUSH=0
# Dedicated Discord channels (channel → 整合 → Webhook → 复制URL);
# each falls back to DISCORD_WEBHOOK_URL when unset. Live assignment:
#   #trade-signal → DISCORD_WEBHOOK_URL — PRE-pump signals (launch watch,
#                   lock rising, curve near graduation…) — 暴涨前, not after
#   #filter-log   → DISCORD_FILTER_WEBHOOK_URL + DISCORD_REVIEW_WEBHOOK_URL
#                   (daily mover judgments + confirmation checklist)
#   #trade-log    → DISCORD_TRADE_WEBHOOK_URL (entries/exits/vetoes + P&L)
#DISCORD_REVIEW_WEBHOOK_URL=
#DISCORD_FILTER_WEBHOOK_URL=
#DISCORD_TRADE_WEBHOOK_URL=
# The daily mover candidates PAUSE for human confirmation:
#   /review-confirm [exclude:1,3]   (Discord control bot)
#   npm run review:confirm [-- --exclude=1,3]
# Excluded tokens go to data/review-denylist.json permanently.
# LLM narrative in the daily report uses ANTHROPIC_API_KEY if present
#REVIEW_ANALYST_MODEL=claude-opus-5

# --- Trading (phase 2) ---
# off (default) | paper (simulated fills) | live (real swaps — DANGER)
TRADE_MODE=off
# Wallet key for LIVE mode only. Never commit. Use a dedicated hot wallet
# funded with only what you can lose.
#TRADER_PRIVATE_KEY=
TRADE_USD_PER_TRADE=50
TRADE_MAX_DAILY_USD=200
TRADE_MAX_OPEN_POSITIONS=3
TRADE_MIN_LIQUIDITY_USD=50000
TRADE_SLIPPAGE_BPS=100
TRADE_TRAIL_STOP_PCT=0.25
TRADE_HARD_STOP_PCT=0.35
TRADE_MAX_HOLD_HOURS=96
#TRADE_ENTRY_TRIGGERS=lock_strong,lock_rising_strong,boner_composite
#TRADE_DENYLIST=

# Optional LLM exit advisor (early exits only; never overrides stops).
# Requires ANTHROPIC_API_KEY. One call per open position per hour.
TRADE_LLM_ADVISOR=0
#ANTHROPIC_API_KEY=
#TRADE_ADVISOR_MODEL=claude-opus-5
