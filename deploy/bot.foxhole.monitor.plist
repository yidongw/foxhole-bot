<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>bot.foxhole.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Pinned to Homebrew node: the pump-sdk dependency chain needs
             Node >=26 ESM interop (@coral-xyz/anchor BN export fails on 22) -->
        <string>cd /Users/xinjuan/git/foxhole-bot &amp;&amp; PATH=/opt/homebrew/bin:/usr/bin:/bin exec /opt/homebrew/bin/npx tsx src/cli/monitor.ts</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/xinjuan/preview/logs/foxhole-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xinjuan/preview/logs/foxhole-monitor.log</string>
</dict>
</plist>
