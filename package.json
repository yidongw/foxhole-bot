{
  "name": "foxhole-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Robinhood Chain meme trading intelligence — Long.xyz launch & squeeze monitoring",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "fetch:long": "tsx src/cli/fetch-long.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "scan": "tsx src/cli/scan.ts",
    "monitor": "tsx src/cli/monitor.ts",
    "monitor:once": "tsx src/cli/monitor.ts --once",
    "backtest": "tsx src/cli/backtest.ts",
    "backtest:grid": "tsx src/cli/backtest-grid.ts",
    "review": "tsx src/cli/review.ts",
    "review:confirm": "tsx src/cli/review.ts --confirm",
    "factory:backfill": "tsx src/cli/factory-backfill.ts",
    "positions": "tsx src/cli/positions.ts",
    "news": "tsx src/cli/news.ts",
    "news:search": "tsx src/cli/news.ts search",
    "smartmoney": "tsx src/cli/smart-money.ts",
    "preflight": "tsx src/cli/preflight.ts",
    "opennews": "tsx src/cli/opennews.ts",
    "hl": "tsx src/cli/hl.ts",
    "oi-scan": "tsx src/cli/oi-scan.ts",
    "okx": "tsx src/venues/okx/smoke.ts",
    "deploy": "bash scripts/deploy-local.sh",
    "serve": "python3 -m http.server 8787 --directory web",
    "dev": "npm run fetch:long && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ai": "tsx src/cli/ai-trade.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@goplus/sdk-node": "1.1.2",
    "@jup-ag/api": "6.0.48",
    "@pump-fun/pump-sdk": "1.36.0",
    "@solana/web3.js": "1.98.4",
    "discord.js": "14.27.0",
    "hoodchain": "^0.1.1",
    "viem": "^2.35.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@nktkas/hyperliquid": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
